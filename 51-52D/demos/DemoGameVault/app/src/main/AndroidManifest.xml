<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To show the active play session (see AndroidPlaySessionNotifier) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- To show the active play session as a Live Update (e.g. in a status bar chip), since
         Android 16. It is granted at install time. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:name=".DemoGameVaultApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DemoGameVault">
        <activity
            android:name=".home.HomeActivity"
            android:exported="true"
            android:theme="@style/Theme.DemoGameVault"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".settings.SettingsActivity" android:exported="true" />
        <activity android:name=".search.platforms.SearchForPlatformActivity" android:exported="true" />
        <activity android:name=".search.games.SearchForGamesActivity" android:exported="true" />
        <activity android:name=".collection.platforms.PlatformCollectionActivity" android:exported="true" />
        <activity android:name=".collection.games.GameCollectionActivity" android:exported="true" />
        <activity android:name=".collection.games.details.GameDetailsActivity" android:exported="false" />

        <!-- Records the dismissal of the play session's notification (sent by the system on
             behalf of the app, through the notification's delete intent) -->
        <receiver
            android:name=".adapters.notifications.PlaySessionDismissedReceiver"
            android:exported="false" />
    </application>

</manifest>