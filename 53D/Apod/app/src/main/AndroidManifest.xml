<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".NasaApodApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NasaApod">
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NasaApod"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.details.DetailsActivity"
            android:exported="false"
            android:label="@string/title_activity_details"
            android:theme="@style/Theme.NasaApod"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.bookmarks.BookmarksActivity"
            android:exported="false"
            android:label="@string/title_activity_bookmarks"
            android:theme="@style/Theme.NasaApod"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.infiniteapods.InfiniteApodsActivity"
            android:exported="false"
            android:label="@string/title_activity_infinite_apods"
            android:theme="@style/Theme.NasaApod"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>